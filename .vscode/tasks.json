{
	"version": "2.0.0",
	"tasks": [
		{
			"label": "Build Linux x86_64 musl (Release)",
			"type": "shell",
			"options": {
				"cwd": "${workspaceFolder}",
				"shell": {
					"executable": "C:/Program Files/PowerShell/7/pwsh.exe",
					"args": ["-NoProfile", "-Command"]
				}
			},
			"command": "cargo build --release --locked --target x86_64-unknown-linux-musl",
			"isBackground": false,
			"problemMatcher": [
				"$rustc"
			],
			"group": "build"
		}
	]
}
